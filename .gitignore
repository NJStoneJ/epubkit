# Byte-compiled / cached
__pycache__/
*.py[cod]
*.so

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
wheelhouse/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp

# Local scratch
scratch/
*.local.md

# Sample books: 3.4 MB of third-party binaries, reproducible from source.
# Run `python examples/fetch_examples.py`. Keep examples/README.md tracked.
examples/*.epub
examples/*.mobi
examples/*.azw3

# Test fixtures are generated by tests/fixtures/make_fixtures.py on the first
# test run. Committing them would mean two sources of truth that drift.
# Keep make_fixtures.py tracked; it is the actual fixture definition.
tests/fixtures/*.epub
